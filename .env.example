# Server Configuration
# Note: 5003 is recommended on macOS because port 5000 is reserved by macOS AirPlay Receiver
PORT=5003
NODE_ENV=development

# Database Connection (Local or MongoDB Atlas)
# Local: mongodb://127.0.0.1:27017/trade-activity-dashboard
# Atlas (Required for Vercel): mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/trade-activity-dashboard?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/trade-activity-dashboard

# JWT Authentication
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# Cron Job & Automated Reporting
REPORT_CRON_SCHEDULE=0 1 * * *
REPORTS_DIR=./reports
CRON_SECRET=optional_secret_to_protect_vercel_cron
